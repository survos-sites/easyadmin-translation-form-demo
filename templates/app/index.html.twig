{% extends 'base.html.twig' %}

{% block title %}Hello AppController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">

    {% for locale in app.enabled_locales() %}
        <button>
            <a href="{{ path('admin', {_locale: locale}) }}">EZ ADMIN in {{ locale|language_name }}</a>
            <a href="{{ path('app_homepage', {_locale:locale}) }}">Homepage {{ locale|language_name }}</a>
        </button>
    {% endfor %}

    {% for a in articles %}
        <li>
            {{ ux_icon(a|get_class) }}
            <h3>{{ a.title|default('~~') }}</h3>
            {{ a.author }}
            <ol>
                {% for t in a.translations %}
                <li>
                    {{ t.locale }}: {{ t.title }}
                {% endfor %}
                </li>

            </ol>
        </li>
    {% endfor %}
</div>
{% endblock %}
